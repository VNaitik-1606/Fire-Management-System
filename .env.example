# Application runtime
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

# Database connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# NASA FIRMS Area API credentials (never expose to frontend)
# Obtain from: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=your_nasa_firms_map_key_here

# Authentication / scheduler secrets (use long random strings in production)
SESSION_SECRET=replace_with_a_long_random_secret
CRON_SECRET=replace_with_a_long_random_cron_secret
